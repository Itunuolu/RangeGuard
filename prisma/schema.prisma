generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  walletAddress String            @unique
  email         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  strategies    Strategy[]
  positions     Position[]
  actions       SuggestedAction[]
  botPolicies   BotPolicy[]
  botRuns       BotRun[]
  botActions    BotAction[]
  tradeSimulations TradeSimulation[]
}

model Pool {
  id              String     @id @default(cuid())
  poolAddress     String     @unique
  protocol        String
  tokenAMint      String
  tokenBMint      String
  tokenASymbol    String
  tokenBSymbol    String
  liquidityUsd    Float
  volume24hUsd    Float
  feeApr          Float
  volatilityScore Int
  riskScore       Int
  riskLabel       String
  riskReasons     Json
  activeBin       Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastScannedAt   DateTime?
  positions       Position[]
}

model Strategy {
  id                 String     @id @default(cuid())
  userId             String
  name               String
  riskLevel          String
  maxPositionSizeUsd Float
  preferredPoolType  String
  minLiquidityUsd    Float
  minVolume24hUsd    Float
  maxRiskScore       Int
  rangeWidth         String
  rebalanceTrigger   String
  stopLossPct        Float
  takeProfitPct      Float
  status             String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions          Position[]
}

model Position {
  id                 String            @id @default(cuid())
  userId             String
  strategyId         String?
  poolId             String
  positionAddress    String?           @unique
  entryValueUsd      Float
  currentValueUsd    Float
  estimatedPnlUsd    Float
  estimatedPnlPct    Float
  feesEarnedUsd      Float
  lowerBin           Int
  upperBin           Int
  activeBinAtEntry   Int?
  currentActiveBin   Int?
  healthStatus       String
  healthScore        Int
  suggestedAction    String
  status             String
  openedAt           DateTime
  closedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy           Strategy?         @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  pool               Pool              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  events             PositionEvent[]
  suggestedActions   SuggestedAction[]
  botActions         BotAction[]

  @@index([userId, status])
  @@index([poolId])
  @@index([strategyId])
}

model PositionEvent {
  id          String   @id @default(cuid())
  positionId  String
  eventType   String
  txSignature String?
  message     String
  metadata    Json
  createdAt   DateTime @default(now())
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, createdAt])
  @@index([txSignature])
  @@index([eventType, createdAt])
}

model SuggestedAction {
  id         String    @id @default(cuid())
  userId     String
  positionId String
  type       String
  priority   String
  status     String
  reason     String
  metadata   Json
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([positionId, status])
  @@index([type, status])
}

model BotPolicy {
  id                     String      @id @default(cuid())
  userId                 String
  name                   String
  mode                   String
  status                 String
  executionMode          String
  maxPositionSizeUsd     Float
  dailyNotionalLimitUsd  Float
  maxSlippageBps         Int
  maxPoolRiskScore       Int
  minPoolLiquidityUsd    Float
  maxOpenPositions       Int
  dailyRebalanceLimit    Int
  stopLossPct            Float
  takeProfitPct          Float
  allowedPoolTypes       Json
  allowedPoolAddresses   Json
  requireSimulation      Boolean     @default(true)
  requireWalletConfirm   Boolean     @default(true)
  guardProgramId         String?
  onChainPolicyAddress   String?
  delegatedAuthority     String?
  riskAuthority          String?
  policyHash             String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                   BotRun[]
  actions                BotAction[]
}

model BotRun {
  id           String      @id @default(cuid())
  userId       String
  policyId     String
  status       String
  mode         String
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  positionsScanned Int
  actionsPlanned   Int
  actionsBlocked   Int
  metadata     Json
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy       BotPolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  actions      BotAction[]
}

model BotAction {
  id                   String      @id @default(cuid())
  userId               String
  policyId             String
  runId                String?
  positionId           String?
  type                 String
  status               String
  priority             String
  protocol             String
  title                String
  reason               String
  notionalUsd          Float
  estimatedFeeUsd      Float
  simulatedGrossProfitUsd Float?
  estimatedSlippageBps Int
  proposedLowerBin     Int?
  proposedUpperBin     Int?
  simulationStatus     String
  executionStatus      String
  guardrailResults     Json
  transactionPlan      Json
  createdAt            DateTime    @default(now())
  queuedAt             DateTime?
  executedAt           DateTime?
  resolvedAt           DateTime?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy               BotPolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  run                  BotRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  position             Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([policyId, status])
  @@index([positionId])
  @@index([executionStatus])
  @@index([type, status])
}

model TradeSimulation {
  id                      String   @id @default(cuid())
  userId                  String?
  walletAddress           String?
  poolAddress             String
  investedCapitalUsd      Float
  simulatedGrossProfitUsd Float
  simulatedNetProfitUsd   Float?
  profitDeductionBps      Int?
  profitDeductionUsd      Float?
  tradingTier             String?
  settlementStatus        String
  createdAt               DateTime @default(now())
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([walletAddress, createdAt])
  @@index([poolAddress, createdAt])
  @@index([tradingTier])
}
